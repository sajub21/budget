// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  timezone      String    @default("UTC")
  theme         String    @default("system")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  calendars     Calendar[]
  events        Event[]
  sessions      Session[]
  accounts      Account[]
  subscription  Subscription?
  notifications Notification[]
  files         File[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Calendar {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3b82f6")
  isDefault   Boolean  @default(false)
  isVisible   Boolean  @default(true)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@map("calendars")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean   @default(false)
  location    String?
  color       String?
  status      String    @default("confirmed") // confirmed, tentative, cancelled
  visibility  String    @default("private") // private, public
  recurrence  Json? // Stores recurrence rules
  reminders   Json? // Array of reminder times
  attendees   Json? // Array of attendee emails
  userId      String
  calendarId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  files    File[]

  @@map("events")
}

model File {
  id        String   @id @default(cuid())
  filename  String
  url       String
  type      String // image, video, document
  size      Int
  mimeType  String
  userId    String
  eventId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("files")
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  stripeCustomerId  String    @unique
  stripeSubscriptionId String? @unique
  stripePriceId     String?
  status            String // active, canceled, incomplete, past_due, etc.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  type      String // email, push, sms
  title     String
  message   String
  isRead    Boolean  @default(false)
  isSent    Boolean  @default(false)
  scheduledFor DateTime?
  sentAt    DateTime?
  userId    String
  eventId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
